# Peacock POS — environment template.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is not, so never put a real
# password here.
#
# Nothing loads `.env` automatically: the binaries read the process environment. Source it
# yourself, or use `direnv`:
#
#   set -a && . ./.env && set +a && cargo run -p peacock-api
#
# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# The only required variable. `peacock-api` refuses to start without it — there is no
# in-memory fallback, because a POS that silently kept a shift's orders in memory would
# lose them at the next restart.
#
# Local Postgres, current OS user, no password:
DATABASE_URL=postgres://localhost:5432/peacock
#
# With credentials:
# DATABASE_URL=postgres://peacock:CHANGE_ME@localhost:5432/peacock
#
# Managed Postgres usually requires TLS:
# DATABASE_URL=postgres://user:CHANGE_ME@db.example.com:5432/peacock?sslmode=require

# ---------------------------------------------------------------------------
# Database (optional) — see peacock-storage/src/config.rs
# ---------------------------------------------------------------------------
# Pool size. Defaults to (2 × CPUs) + 1, floored at 5.
# PEACOCK_DB_MAX_CONNECTIONS=9
# PEACOCK_DB_MIN_CONNECTIONS=1

# How long a request waits for a free connection before failing. Must be > 0: a POS
# request that cannot get a connection should fail loudly rather than hang the till.
# PEACOCK_DB_ACQUIRE_TIMEOUT_SECS=10

# Recycling, so a Postgres restart does not leave the pool holding dead sockets.
# 0 disables either timeout.
# PEACOCK_DB_IDLE_TIMEOUT_SECS=600
# PEACOCK_DB_MAX_LIFETIME_SECS=1800

# Applied per session via `SET statement_timeout`. Guards against a runaway report query
# pinning a connection. 0 disables it.
# PEACOCK_DB_STATEMENT_TIMEOUT_SECS=30

# Apply pending migrations on startup. Defaults to true.
#
# Set to false when several terminals start at once against one database and you would
# rather run migrations as a separate deploy step: sqlx takes a lock, so concurrent
# starters serialise rather than corrupt anything, but the losers wait.
# PEACOCK_DB_RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# HTTP server — see peacock-api/src/config.rs
# ---------------------------------------------------------------------------
# PEACOCK_API_HOST=0.0.0.0
# PEACOCK_API_PORT=3000

# Exact origins allowed by CORS, comma-separated. Credentials are enabled, so the Fetch
# spec forbids a wildcard — every origin must be listed.
# PEACOCK_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pos.example.com

# `pretty` for local development, `json` for log shippers.
# PEACOCK_LOG_FORMAT=pretty

# Prefix for RFC 7807 problem `type` URIs.
# PEACOCK_PROBLEM_BASE_URI=https://peacock-pos.example.com/errors

# HMAC-SHA256 secret for aggregator webhook signatures. Unset means webhook signature
# validation is disabled, which is only safe on a trusted LAN.
# PEACOCK_WEBHOOK_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The integration tests create a throwaway database per test and drop it afterwards. This
# points at any database on the target server; it is used only to issue CREATE DATABASE and
# is never written to. Falls back to DATABASE_URL, then to postgres://localhost:5432/postgres.
# TEST_DATABASE_URL=postgres://localhost:5432/postgres
